---
interface Props {
    date: string
    title: string
    subtitle: string
    description?: string
}
const { date, title, subtitle, description } = Astro.props
---

<article class="timeline-item">
    <span class="timeline-item__date">{date}</span>
    <div class="timeline-item__body">
        <h3 class="timeline-item__title">{title}</h3>
        <span class="timeline-item__subtitle">{subtitle}</span>
        {description && <p class="timeline-item__description">{description}</p>}
        <slot />
    </div>
</article>

<style>
    .timeline-item {
        display: grid;
        gap: 8px;
        padding: 20px 0;
    }

    .timeline-item__date {
        color: var(--color-text-subtle);
    }

    .timeline-item__body {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .timeline-item__title {
        font-family: var(--font-serif);
        font-size: 20px;
        font-weight: 600;
        line-height: 1.25;
    }

    .timeline-item__subtitle {
        color: var(--color-yellow);
    }

    .timeline-item__description {
        margin-top: 4px;
        color: var(--color-text-muted);
    }

    @media (min-width: 640px) {
        .timeline-item {
            grid-template-columns: 170px minmax(0, 1fr);
            gap: 24px;
        }

        .timeline-item__date {
            padding-top: 4px;
        }

        .timeline-item__title {
            font-size: 22px;
        }
    }
</style>
