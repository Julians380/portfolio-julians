---
import SectionContainer from './SectionContainer.astro';

const navItems = [
  {
    title: 'proyectos',
    label: 'proyectos',
    url: '#proyectos',
  },
  {
    title: 'stack',
    label: 'stack',
    url: '#stack',
  },
  {
    title: 'experiencia',
    label: 'experiencia',
    url: '#experiencia',
  },
  {
    title: 'contacto',
    label: 'contacto',
    url: '#contacto',
  },
]
---

<header class="header">
  <SectionContainer>
    <nav class="header__nav" aria-label="Principal">
      <a class="header__brand" href="#inicio">Fender</a>
      <ul class="header__list">
        {
          navItems.map((link) => (
            <li>
              <a class="header__link" data-section={link.label} href={link.url}>
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </SectionContainer>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section[id]')
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.header__link')

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        navLinks.forEach((link) => {
          const isActive = link.dataset.section === entry.target.id
          link.classList.toggle('header__link--active', isActive)
          if (isActive) {
            link.setAttribute('aria-current', 'true')
          } else {
            link.removeAttribute('aria-current')
          }
        })
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: '-40% 0px -55% 0px',
      threshold: 0,
    })

    sections.forEach((section) => observer.observe(section))
  })
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(26 22 17 / 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-deep);
  }

  .header__nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 0;
  }

  .header__brand {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .header__list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 13px;
  }

  .header__link {
    display: inline-block;
    padding: 4px 0;
    color: var(--color-text-muted);
  }

  .header__link--active {
    color: var(--color-yellow);
  }

  @media (min-width: 768px) {
    .header__nav {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 18px 0;
    }

    .header__list {
      gap: 24px;
    }
  }
</style>
