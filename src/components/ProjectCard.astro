---
import type { Tag as TagData } from '@/data/tags';
import GithubIcon from './icons/Github.astro';
import LinkIcon from './icons/Link.astro';
import Tag from './Tag.astro';

interface Props {
    tag: string
    stack: TagData[]
    title: string
    description: string
    client?: string
    link?: string
    github?: string
    image?: string
}
const { tag, stack, title, description, client, link, github, image } = Astro.props
---

<article class="project-card">
    <div class="project-card__preview">
        {
            image ? (
                <img
                    class="project-card__image"
                    src={image}
                    alt={`Captura de pantalla del proyecto ${title}`}
                    width="960"
                    height="720"
                    loading="lazy"
                />
            ) : (
                <span class="project-card__placeholder">Proyecto privado</span>
            )
        }
    </div>

    <div class="project-card__meta">
        <span class="project-card__tag">{tag}</span>
        <ul class="project-card__stack">
            {
                stack.map((tech) => (
                    <li>
                        <Tag tag={tech} />
                    </li>
                ))
            }
        </ul>
    </div>
    <h3 class="project-card__title">{title}</h3>
    <p class="project-card__description">{description}</p>
    <footer class="project-card__footer">
        {client && <span class="project-card__client">{client}</span>}
        {
            link && (
                <a class="project-card__link" href={link} target="_blank" rel="noopener noreferrer">
                    <LinkIcon class="project-card__link-icon" />
                    Ver sitio
                </a>
            )
        }
        {
            github && (
                <a class="project-card__link" href={github} target="_blank" rel="noopener noreferrer">
                    <GithubIcon class="project-card__link-icon" />
                    Código
                </a>
            )
        }
    </footer>
</article>

<style>
    .project-card {
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 100%;
    }

    .project-card__preview {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 200px;
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface);
    }

    .project-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        transition: transform 0.5s;
    }

    .project-card:hover .project-card__image {
        transform: scale(1.03);
    }

    .project-card__placeholder {
        color: var(--color-text-subtle);
    }

    .project-card__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        font-size: 11px;
        color: var(--color-text-muted);
    }

    .project-card__tag {
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        background: var(--color-surface-alt);
    }

    .project-card__title {
        font-family: var(--font-serif);
        font-size: 22px;
        font-weight: 600;
        line-height: 1.2;
    }

    .project-card__description {
        color: var(--color-text-muted);
    }

    .project-card__stack {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
    }

    .project-card__footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 4px 20px;
        margin-top: auto;
    }

    .project-card__link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 32px;
        color: var(--color-yellow);
    }

    .project-card__link:hover {
        color: var(--color-text);
    }

    .project-card__link-icon {
        width: 16px;
        height: 16px;
    }

    .project-card__client {
        padding: 6px 0;
        color: var(--color-text-subtle);
    }
</style>
